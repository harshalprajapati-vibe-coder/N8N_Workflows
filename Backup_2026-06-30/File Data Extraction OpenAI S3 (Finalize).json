      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n// for (const item of $input.all()) {\n//   item.json.myNewField = 1;\n// }\n\nconst json = $input.all()[0].json;\n\nconst missing = [];\n\nif (!json.document_type)\n  missing.push(\"document_type\");\n\n// if (!json.company?.name)\n//   missing.push(\"company.name\");\n\n// if (!json.quotation?.quotation_number)\n//   missing.push(\"quotation.quotation_number\");\n\n// if (json.pricing?.total_amount == null)\n//   missing.push(\"pricing.total_amount\");\n \n\nreturn [{\n  json: {\n    ...json,\n    isValid: missing.length === 0,\n    missingFields: missing\n  }\n}];"
      },
