    {
      "parameters": {
        "jsCode": "// Parse LLM response\nconst data = $input.first().json.user;\n\n\n// Define all rules in one place\nconst rules =  $input.first().json.rules;\n  \n// Compute derived fields\nconst ownerCount = data.owners?.length || 0;\n\n// Add computed fields\nconst normalizedData = {\n  ...data,\n  owner_count: ownerCount\n};\n\nconst appliedRules = [];\nconst ruleResults = [];\n\nconst actions = {\n  approvers: [],\n  notify: [],\n  required_documents: [],\n  flags: [],\n  business_rules: []\n};\n\n// Evaluate rules\n \nfor (const rule of rules) {\n\n  const results = [];\n\n  for (const condition of rule.conditions) {\n\n    const fieldValue =\n      normalizedData[condition.field];\n\n    let matched = false;\n\n    if (\n      fieldValue !== null &&\n      fieldValue !== undefined\n    ) {\n\n      switch (condition.operator) {\n\n        case \"<\":\n          matched =\n            Number(fieldValue) <\n            Number(condition.value);\n          break;\n\n        case \">\":\n          matched =\n            Number(fieldValue) >\n            Number(condition.value);\n          break;\n\n        case \"=\":\n        case \"equals\":\n          matched =\n            String(fieldValue).trim().toUpperCase() ===\n            String(condition.value).trim().toUpperCase();\n          break;\n\n        case \"contains\":\n          matched =\n            String(fieldValue)\n              .toUpperCase()\n              .includes(\n                String(condition.value)\n                  .toUpperCase()\n              );\n          break;\n      }\n\n    }\n\n    results.push(matched);\n  }\n\n  const matched =\n    rule.condition_logic === \"OR\"\n      ? results.some(Boolean)\n      : results.every(Boolean);\n\n  if (matched) {\n\n    appliedRules.push(rule.rule_id);\n\n    ruleResults.push({\n      rule_id: rule.rule_id,\n      rule_name: rule.name,\n      matched: true\n    });\n\n    Object.entries(rule.actions)\n      .forEach(([actionType, values]) => {\n\n        if (!actions[actionType]) {\n          actions[actionType] = [];\n        }\n\n        actions[actionType].push(...values);\n      });\n\n  } else {\n\n    ruleResults.push({\n      rule_id: rule.rule_id,\n      rule_name: rule.name,\n      matched: false\n    });\n\n  }\n}\n\n// Remove duplicates\nfor (const key of Object.keys(actions)) {\n  actions[key] = [...new Set(actions[key])];\n}\n\n// Return final response\n// return [\n//   {\n//     json: {\n//       user_id:data.id,\n//       // extracted_data: data,\n//       owner_count: ownerCount,\n//       applied_rules: [...new Set(appliedRules)],\n//       rule_results: ruleResults,\n//       actions: actions\n//     }\n//   }\n// ];\nreturn [\n{\n  json: {\n    user_id: Number(data.id),\n    owner_count: ownerCount,\n\n    applied_rules: {\n      rules: [...new Set(appliedRules)]\n    },\n\n    rule_results: {\n      results: ruleResults\n    },\n\n    actions\n  }\n}\n];"
      },
